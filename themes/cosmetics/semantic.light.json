{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "mode": "light",
  "colors": {
    "background": { "$type": "color", "$value": "{brand.colors.porcelain}" },
    "foreground": { "$type": "color", "$value": "{brand.colors.ink}" },
    "surface": { "$type": "color", "$value": "{brand.colors.shell}" },
    "surfaceAlt": { "$type": "color", "$value": "{brand.colors.cream}" },
    "primary": { "$type": "color", "$value": "{brand.colors.botanical}" },
    "onPrimary": { "$type": "color", "$value": "#FFFFFF" },
    "accent": { "$type": "color", "$value": "{brand.colors.blush}" },
    "onAccent": { "$type": "color", "$value": "#FFFFFF" },
    "cta": { "$type": "color", "$value": "{brand.colors.ink}" },
    "onCta": { "$type": "color", "$value": "#FFFFFF" },
    "border": { "$type": "color", "$value": "{brand.colors.clay}" },
    "muted": { "$type": "color", "$value": "#E9DED2" },
    "mutedForeground": { "$type": "color", "$value": "#4D4137" },
    "success": { "$type": "color", "$value": "#2F7D55" },
    "onSuccess": { "$type": "color", "$value": "#FFFFFF" },
    "warning": { "$type": "color", "$value": "#735600" },
    "onWarning": { "$type": "color", "$value": "#FFFFFF" },
    "danger": { "$type": "color", "$value": "#A43B40" },
    "onDanger": { "$type": "color", "$value": "#FFFFFF" },
    "focusRing": { "$type": "color", "$value": "{brand.colors.botanical}" }
  }
}
