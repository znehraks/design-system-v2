{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@designc/foundation": ["packages/foundation/src/index.ts"],
      "@designc/theme": ["packages/theme/src/index.ts"],
      "@designc/ui-web": ["packages/ui-web/src/index.ts"],
      "@designc/ui-native": ["packages/ui-native/src/index.ts"]
    }
  }
}
